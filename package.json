{
  "name": "cinaseek",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "scripts": {
    "app:electron": "pnpm --filter @cinaseek/app-electron dev",
    "app:electron:package": "pnpm --filter @cinaseek/app-electron package",
    "app:electron:package:win": "pnpm --filter @cinaseek/app-electron package:win",
    "app:mobile:sync": "pnpm --filter @cinaseek/app-mobile sync",
    "app:mobile:android": "pnpm --filter @cinaseek/app-mobile open:android",
    "app:mobile:ios": "pnpm --filter @cinaseek/app-mobile open:ios",
    "build": "vp run -r --cache build",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "run-local": "node scripts/run-local.ts",
    "test": "node --test \"scripts/**/*.test.ts\" && node --test scripts/*.test.js && vp run --filter \"!cinaseek\" --cache test",
    "preview:config": "node scripts/preview/preview.ts config",
    "preview:deploy": "node scripts/preview/preview.ts deploy",
    "preview:delete": "node scripts/preview/preview.ts delete",
    "preview:sweep": "node scripts/preview/preview.ts sweep",
    "dev-client": "cd packages/workshop-frontend && pnpm run dev",
    "dev-server": "node scripts/run-dev-server.ts",
    "clean": "vp run -r clean",
    "lint:check": "vp lint",
    "lint:fix": "vp lint --fix",
    "types:check": "pnpm run build",
    "types:scripts": "tsc -p scripts/tsconfig.json",
    "lint": "pnpm run lint:check && pnpm run types:scripts && pnpm run types:check",
    "types:generate": "node scripts/generate-worker-types.ts"
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "aws4fetch": "^1.0.20",
    "jsdom": "^26.1.0",
    "jsonc-parser": "^3.3.1",
    "typescript": "catalog:",
    "typescript6": "npm:typescript@6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  }
}
